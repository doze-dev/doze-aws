# Runtime data — service stores are never committed.
/data/
*.db
*.bolt

# Build output.
/bin/
/dist/
/doze-aws

# Go test / coverage artifacts.
*.test
*.out
coverage.*

# Editor / OS noise.
.DS_Store

# e2e/ (Playwright/Bun toolchain — bun.lock IS committed).
e2e/node_modules/
e2e/.tmp/
e2e/playwright-report/
e2e/test-results/
e2e/blob-report/
e2e/.bun/

# Fetched AWS service models — the audit spec, cached not vendored (15M).
# dzaudit refetches on demand: go run ./cmd/dzaudit coverage
.audit-models/

# The dzaudit binary, if you build it in the repo root. `go build ./cmd/dzaudit`
# writes it here, and an 8.5 MB platform-specific artifact was committed twice
# before anyone noticed. Run it with `go run ./cmd/dzaudit` instead.
/dzaudit
